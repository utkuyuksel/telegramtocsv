# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# --- Telegram API (from https://my.telegram.org) ---
TG_API_ID=29450227
TG_API_HASH=d67cd4356e9a800361249d0de861869c
TG_BOT_TOKEN=

# --- Flask ---
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URI=sqlite:///database.db
HOST=0.0.0.0
PORT=8050

# --- Admin Panel Auth ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# --- Pricing (paid tier is priced "by size"; whole channel, no message cap) ---
FREE_MESSAGE_LIMIT=100
# Quote = max(PAID_MIN_PRICE_USDT, ceil(messages / 1000) * PAID_PRICE_PER_1K_USDT),
# then capped at PAID_MAX_PRICE_USDT.
# With 0.50 / 3.00 min / 15 ceiling => 1k=$3, 10k=$5, 20k=$10, 30k+=$15 (flat).
PAID_PRICE_PER_1K_USDT=0.50
PAID_MIN_PRICE_USDT=3.00
# Price ceiling: no single export costs more than this, any channel size. 0 = off.
PAID_MAX_PRICE_USDT=15.00
WALLET_ADDRESS=YOUR_TRC20_WALLET_HERE

# --- Multi-network USDT wallets (TRC20 falls back to WALLET_ADDRESS above) ---
# ERC20 and BEP20 are EVM chains and can share one 0x address. Defaults are also
# baked into config.py, so leaving these blank still works.
WALLET_TRC20=
WALLET_BEP20=0x13283FE0f73dB30239f4a616853fc568a95634Ab
WALLET_ERC20=0x13283FE0f73dB30239f4a616853fc568a95634Ab
# Keyless public JSON-RPC for EVM verification (no API key). Override only if rate-limited.
ETH_RPC_URL=https://ethereum.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ETH_MIN_CONF=3
BSC_MIN_CONF=2
DEFAULT_NETWORK=TRC20

# --- Rate Limits ---
DAILY_IP_LIMIT=100
FILE_RETENTION_HOURS=1
